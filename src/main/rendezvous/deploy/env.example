RENDEZVOUS_BIND_HOST=127.0.0.1
STUN_BIND_HOST=0.0.0.0
RENDEZVOUS_PORT=8443
STUN_PORT=3478

# Set false when coturn owns 3478 and also provides STUN.
STUN_ENABLED=false

# Generate with: openssl rand -hex 32
TURN_URLS=turn:VPS_PUBLIC_IP:3478?transport=udp,turn:VPS_PUBLIC_IP:443?transport=tcp
TURN_SHARED_SECRET=CHANGE_ME_SAME_VALUE_AS_COTURN_STATIC_AUTH_SECRET
TURN_CREDENTIAL_TTL_SECONDS=86400
# Use relay temporarily to prove coturn works, then restore all for direct-first.
TURN_ICE_TRANSPORT_POLICY=all

# Production WSS only:
# TLS_CERT_PATH=/etc/letsencrypt/live/p2p.example.com/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/p2p.example.com/privkey.pem
